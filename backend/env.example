# ============================================================
# SARAN BACKEND - Environment Variables
# ============================================================
# SETUP: cp env.example .env  then edit .env with your values
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=3000

# ============================================================
# MongoDB Configuration
# ============================================================
# OPTION A - Local MongoDB (install MongoDB Community locally):
#   Install: https://www.mongodb.com/try/download/community
#   Then use: mongodb://localhost:27017/saran
#
# OPTION B - MongoDB Atlas (free cloud, no local install needed):
#   Create free cluster: https://cloud.mongodb.com
#   Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/saran?retryWrites=true&w=majority

# Uncomment one of the following:
MONGODB_URI=mongodb://localhost:27017/saran
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/saran?retryWrites=true&w=majority

# ============================================================
# JWT Configuration (REQUIRED)
# ============================================================
# Change this to any long random string for local dev
JWT_SECRET=local-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================
# AWS S3 Configuration (OPTIONAL for local dev)
# ============================================================
# Leave these as-is for local development.
# Without real AWS credentials, uploaded files will be saved
# to the local /uploads folder instead of S3. This is fine for local dev.
# For production/EC2: create an S3 bucket and fill in real values.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=saran-media-storage
# AWS SNS Platform Application ARN for push notifications (FCM/Android)
# Create in AWS Console → SNS → Mobile → Push Notifications
AWS_SNS_PLATFORM_APP_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/GCM/saran-android

# ============================================================
# ============================================================
# OpenAI Configuration (OPTIONAL for local dev)
# ============================================================
# Leave blank to disable AI features. Server will still start normally.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Email Configuration (for OTP verification)
# ============================================================
# If left blank, OTPs are printed to the server console (local dev only).
# For Gmail: use App Password (not your real password).
#   Enable at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=SARAN <your-gmail@gmail.com>

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
