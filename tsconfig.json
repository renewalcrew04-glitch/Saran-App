{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "paths": {
      "@components/*": ["components/*"],
      "@constants/*": ["constants/*"],
      "@services/*": ["services/*"],
      "@types/*": ["types/*"],
      "@hooks/*": ["hooks/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
