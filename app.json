{
  "expo": {
    "name": "SARAN App",
    "slug": "saran-app",
    "scheme": "saran",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.saranapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-router",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70112e43-9b51-4618-b746-a34e676c829f"
      }
    }
  }
}
